# Project Hades Environment Configuration
# Copy this file to .env and adjust values

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Gateway
GATEWAY_PORT=8080
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60s

# Admin API (future)
ADMIN_PORT=8090

# Grafana (future)
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_PASSWORD=admin

# Prometheus (future)
PROMETHEUS_PORT=9090
